<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background"
    tools:context=".HomePrestadorActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <ImageButton
            android:id="@+id/profile_icon_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/sharp_account_circle_24"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:layout_alignParentStart="true"
            android:contentDescription="Acessar Perfil" />

        <TextView
            android:id="@+id/greeting_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/profile_icon_button"
            android:layout_alignTop="@id/profile_icon_button"
            android:layout_alignBottom="@id/profile_icon_button"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:text="Olá, Prestador"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/home_text_color"/>

        <!-- Carrossel de Imagens -->
        <ViewFlipper
            android:id="@+id/carousel_flipper_prestador"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@+id/profile_icon_button"
            android:layout_marginTop="20dp"
            android:autoStart="true"
            android:flipInterval="3000"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/painel1"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/painel3"
                android:scaleType="fitCenter"
                android:contentDescription="@string/carousel_images" />

        </ViewFlipper>

        <!-- Botões de Ação em Grade -->
        <GridLayout
            android:id="@+id/actions_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/carousel_flipper_prestador"
            android:layout_marginTop="20dp"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="true">

            <!-- Botão Gerenciar Agenda -->
            <LinearLayout
                android:id="@+id/schedule_button"
                style="@style/HomeButtonContainer"
                android:background="@drawable/button_rounded_border">
                <ImageView style="@style/HomeButtonIcon" android:src="@drawable/outline_date_range_24" />
                <TextView style="@style/HomeButtonText" android:text="Gerenciar Agenda" android:textColor="@color/home_text_color" />
            </LinearLayout>

            <!-- Botão Gerenciar Fotos -->
            <LinearLayout
                android:id="@+id/photos_button"
                style="@style/HomeButtonContainer"
                android:background="@drawable/button_rounded_border">
                <ImageView style="@style/HomeButtonIcon" android:src="@drawable/outline_add_a_photo_24" />
                <TextView style="@style/HomeButtonText" android:text="Gerenciar Descrição" android:textColor="@color/home_text_color" />
            </LinearLayout>

            <!-- Botão Gerenciar Planos -->
            <LinearLayout
                android:id="@+id/plans_button"
                style="@style/HomeButtonContainer"
                android:background="@drawable/button_rounded_border">
                <ImageView style="@style/HomeButtonIcon" android:src="@drawable/outline_assignment_24" />
                <TextView style="@style/HomeButtonText" android:text="Gerenciar Planos" android:textColor="@color/home_text_color" />
            </LinearLayout>

            <!-- Botão Financeiro -->
            <LinearLayout
                android:id="@+id/finances_button"
                style="@style/HomeButtonContainer"
                android:background="@drawable/button_rounded_border">
                <ImageView style="@style/HomeButtonIcon" android:src="@drawable/outline_account_balance_24" />
                <TextView style="@style/HomeButtonText" android:text="Financeiro" android:textColor="@color/home_text_color" />
            </LinearLayout>

        </GridLayout>

    </RelativeLayout>
</ScrollView>