<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/stilosignup"
    tools:context=".signuptabfragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="360dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp">

                <VideoView
                    android:id="@+id/videoView"
                    android:layout_width="370dp"
                    android:layout_height="205dp"
                    android:layout_gravity="center" />

            </androidx.cardview.widget.CardView>

            <!-- Seletor de Tipo de Usuário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="Tipo de Conta:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"/>

            <RadioGroup
                android:id="@+id/radioGroupUserType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioButtonCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cliente"
                    android:checked="true"
                    android:buttonTint="@android:color/white"
                    android:textColor="@android:color/white"/>

                <RadioButton
                    android:id="@+id/radioButtonPrestador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:buttonTint="@android:color/white"
                    android:text="Prestador de Serviço"
                    android:textColor="@android:color/white"/>
            </RadioGroup>

            <!-- Campos Específicos do Cliente -->
            <LinearLayout
                android:id="@+id/layoutClienteFields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal"
                android:visibility="visible">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Nome Completo"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    android:orientation="horizontal"
                    app:startIconDrawable="@drawable/outline_abc_24"
                    app:startIconTint="@android:color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nomecompleto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Apelido"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:startIconDrawable="@drawable/outline_account_box_24"
                    app:startIconTint="@android:color/white"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apelido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="CPF"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:startIconDrawable="@drawable/outline_3p_24"
                    app:startIconTint="@android:color/white"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_cpf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="14"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Campos Específicos do Prestador -->
            <LinearLayout
                android:id="@+id/layoutPrestadorFields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Razão Social"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:startIconDrawable="@drawable/outline_add_business_24"
                    app:startIconTint="@android:color/white"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/razaoSocial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Nome Fantasia (Opcional)"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:startIconDrawable="@drawable/outline_add_home_work_24"
                    app:startIconTint="@android:color/white"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nomeFantasia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="CNPJ"
                    app:boxStrokeColor="@android:color/white"
                    android:textColorHint="@android:color/white"
                    app:hintTextColor="@android:color/white"
                    app:startIconDrawable="@drawable/outline_account_balance_24"
                    app:startIconTint="@android:color/white"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_cnpj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="18"
                        android:paddingStart="48dp"
                        android:textColor="@android:color/white"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Campos Comuns -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/data_nascimento_layout"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Data de Nascimento"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_date_range_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/data_nascimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Telefone"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_deskphone_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/telefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="19"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/endereco_principal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endereço Principal"
                android:textColor="@android:color/white"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="visible"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cep_layout"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:hint="CEP"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_add_location_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_cep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="9"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/estado_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Estado"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_add_home_24"
                app:startIconTint="@android:color/white">

                <AutoCompleteTextView
                    android:id="@+id/signup_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cidade_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Cidade"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_add_home_24"
                app:startIconTint="@android:color/white">

                <AutoCompleteTextView
                    android:id="@+id/signup_cidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/endereco_layout"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Endereço"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_add_location_alt_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_endereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bairro_layout"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Bairro"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_add_location_alt_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_bairro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/numero_layout"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Número do Endereço"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_123_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_numero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Container for provider-specific address additions -->
            <LinearLayout
                android:id="@+id/prestador_address_additions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <Button
                    android:id="@+id/add_address_button"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Adicionar Endereço"
                    android:backgroundTint="#00167a"
                    app:strokeColor="@android:color/white"
                    app:cornerRadius="20dp"
                    app:strokeWidth="1dp"/>

                <LinearLayout
                    android:id="@+id/additional_address_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Endereço Adicional -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local de Trabalho Adicional (Opcional)"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="24dp"
                        android:layout_gravity="center_horizontal"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cep_layout_2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:hint="CEP 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_add_location_24"
                        app:startIconTint="@android:color/white"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/signup_cep_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/estado_layout_2"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:hint="Estado 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_add_home_24"
                        app:startIconTint="@android:color/white">

                        <AutoCompleteTextView
                            android:id="@+id/signup_estado_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cidade_layout_2"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:hint="Cidade 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_add_home_24"
                        app:startIconTint="@android:color/white">

                        <AutoCompleteTextView
                            android:id="@+id/signup_cidade_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>

                    </com.google.android.material.textfield.TextInputLayout>
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/endereco_layout_2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:hint="Endereço 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_add_location_alt_24"
                        app:startIconTint="@android:color/white"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/signup_endereco_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/bairro_layout_2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:hint="Bairro 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_add_location_alt_24"
                        app:startIconTint="@android:color/white"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/signup_bairro_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/numero_layout_2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:hint="Número do Endereço 2"
                        app:boxStrokeColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        app:hintTextColor="@android:color/white"
                        app:startIconDrawable="@drawable/outline_123_24"
                        app:startIconTint="@android:color/white"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/signup_numero_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:paddingStart="48dp"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Email"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/baseline_email_24"
                app:startIconTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Senha"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_cloud_lock_24"
                app:startIconTint="@android:color/white"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:hint="Confirme a Senha"
                app:boxStrokeColor="@android:color/white"
                android:textColorHint="@android:color/white"
                app:hintTextColor="@android:color/white"
                app:startIconDrawable="@drawable/outline_cloud_lock_24"
                app:startIconTint="@android:color/white"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@android:color/white"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/signup_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:textColor="@android:color/white"/>
            </com.google.android.material.textfield.TextInputLayout>
            
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkbox_termos"
                    android:buttonTint="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/text_termos_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/termos_de_uso_e_privacidade"
                    android:textColor="#FFFFFFFF"
                    android:textColorLink="#FFFFFFFF"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/signup_button"
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:text="Cadastrar"
                android:textSize="18sp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#00167a"
                app:strokeColor="@android:color/white"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"/>

            <TextView
                android:id="@+id/text_go_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem uma conta? Conecte-se"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/white"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>