<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_layout_finances"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    tools:context=".FinancesFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/finances_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_finances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custom_card_background"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Gasto no Mês"
                            android:textColor="@color/card_text_color"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/total_spent_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/card_text_color"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            tools:text="R$ 280,00" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/plans_spent_amount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawablePadding="4dp"
                                android:textColor="@color/card_text_color"
                                android:textSize="16sp"
                                app:drawableStartCompat="@drawable/ic_plans"
                                app:drawableTint="@color/card_text_color"
                                tools:text="R$ 230,00" />

                            <TextView
                                android:id="@+id/services_spent_amount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawablePadding="4dp"
                                android:textColor="@color/card_text_color"
                                android:textSize="16sp"
                                app:drawableStartCompat="@drawable/ic_services"
                                app:drawableTint="@color/card_text_color"
                                tools:text="R$ 50,00" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custom_card_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Histórico de Gastos"
                            android:textColor="@color/card_text_color"
                            android:textSize="18sp" 
                            android:layout_marginBottom="8dp"/>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/spending_chart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />
                            
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_finances"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            tools:listitem="@layout/item_finance_transaction" />

        <ProgressBar
            android:id="@+id/progress_finances"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view_finances"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhuma transação registrada."
            android:textColor="@color/card_text_color"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Movido para antes do FAB para que o FAB fique por cima -->
        <include layout="@layout/view_no_connection" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_expense_client"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add"
            app:tint="@android:color/white"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>