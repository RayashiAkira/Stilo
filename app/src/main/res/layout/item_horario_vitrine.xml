<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/horario_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14:00 - 15:00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"/>

    <TextView
        android:id="@+id/horario_description_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horário disponível para agendamento"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/agendar_button_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Agendar Agora" />

</LinearLayout>