<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/no_connection_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:gravity="center"
    android:visibility="gone">

    <ImageView
        android:id="@+id/no_connection_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_signal_wifi_off"
        app:tint="@color/text_color_selector" />

    <TextView
        android:id="@+id/no_connection_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/no_connection_icon"
        android:layout_centerHorizontal="true"
        android:text="Sem conexão com a internet"
        android:textColor="@color/text_color_selector"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/no_connection_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/no_connection_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Verifique sua conexão e tente novamente."
        android:textColor="@color/text_color_selector"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/no_connection_subtitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="Tentar Novamente"
        android:textColor="@color/text_color_selector" />

</RelativeLayout>
