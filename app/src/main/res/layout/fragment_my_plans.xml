<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background" 
    tools:context=".MyPlansActivity">

    <LinearLayout
        android:id="@+id/my_plans_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header with background -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:title="Meus Planos"
                app:navigationIcon="@drawable/ic_barber_pole"
                app:titleTextColor="@color/white"/>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:animateLayoutChanges="true">

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Veja seus benefícios e pontos em cada parceiro"
                    android:textSize="16sp"
                    android:textColor="@color/text_color_selector"
                    android:layout_margin="8dp"/>

                <!-- Search and Filter Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/custom_card_background"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/search_my_plans_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar por estabelecimentos"
                        android:background="@drawable/button_rounded_border"
                        android:drawableStart="@drawable/outline_manage_search_24"
                        android:drawableTint="@color/text_color_selector"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/text_color_selector"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categorias"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_color_selector"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/category_chip_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleLine="false"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_salao"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salão"
                            android:textColor="@color/text_color_selector"
                            app:chipIcon="@drawable/cuticon"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_barbearia"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Barbearia"
                            android:textColor="@color/text_color_selector"
                            app:chipIcon="@drawable/barbericon"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_massagem"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Massagem"
                            android:textColor="@color/text_color_selector"
                            app:chipIcon="@drawable/massageicon"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unha_sobrancelha"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unha/Sobrancelha"
                            android:textColor="@color/text_color_selector"
                            app:chipIcon="@drawable/outline_cards_star_24"/>
                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/my_plans_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

                <!-- RecyclerView for Plans -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/my_plans_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:listitem="@layout/item_my_plan_partner"
                    tools:itemCount="3"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <include layout="@layout/view_no_connection" />

</RelativeLayout>
